{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellmux",
  "version": "0.1.0",
  "identifier": "dev.shellmux.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shellmux",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 520,
        "titleBarStyle": "Visible",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Open-source SSH client & terminal",
    "longDescription": "Shellmux quản lý host theo nhóm, keychain riêng, SFTP, port forwarding, jump host và snippets — không tính năng nào bị khoá."
  }
}
